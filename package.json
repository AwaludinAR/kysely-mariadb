{
  "name": "kysely-mariadb",
  "version": "0.1.3",
  "description": "MariaDB Dialect for Kysely",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awaludinar/kysely-mariadb"
  },
  "keywords": [
    "mariadb",
    "kysely"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:types": "tsc --noEmit",
    "build": "tsdown",
    "release": "npm run lint && npm run test && npm run build && changelogen --release --push && npm publish"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "kysely": ">=0.28.17 <1",
    "mariadb": "~3.2.6 || ~3.3.5 || ~3.4.8 || ^3.5.5"
  },
  "peerDependenciesMeta": {
    "mariadb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.3.4",
    "@types/node": "^25.0.1",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "kysely": "^0.29.9",
    "mariadb": "^3.5.5",
    "std-env": "^3.10.0",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  }
}
